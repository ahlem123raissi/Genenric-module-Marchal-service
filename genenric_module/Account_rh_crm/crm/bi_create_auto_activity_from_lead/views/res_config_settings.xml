<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="res_config_settings_view_form_inherit_activity" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='convert_visitor_setting_container']" position="before">
                <div id="create_activity_for_lead">
                    <h2>Lead Activity</h2>
                    <setting>
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="o_light_label col-lg-3" string="Activity Person" for="activity_person"/>
                                <field name="activity_person"/>
                            </div>
                            <div class="row">
                                <label class="o_light_label col-lg-3" for="activity_type_id"/>
                                <field name="activity_type_id"/>
                            </div>
                            <div class="row">
                                <label class="o_light_label col-lg-3" for="activity_due_date"/>
                                <field name="activity_due_date"/>
                            </div>
                        </div>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_form_adv_pymt" model="ir.ui.view">
        <field name="name">res.config.settings.form.adv.pymt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="after">
                <setting id="advance_payment" string="Advance Payment">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="advance_payment_account_id" class="col-lg-4 o_light_label" string="Advance Payment Account"/>
                            <field name="advance_payment_account_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>